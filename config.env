# Shared settings read by scripts/*.sh
T3_DOMAIN=t3.example.internal
T3_VERSION=0.0.45
T3_IMAGE=localhost/t3code-workspace:0.0.45
T3_PORT=3773

# Per-workspace resource limits
T3_MEMORY=4g
T3_CPUS=2
T3_PIDS_LIMIT=2048

# Reverse proxy (rootless: unprivileged host ports by default)
CADDY_IMAGE=docker.io/library/caddy:2
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
