# HTTP is explicitly redirected to the configured public HTTPS port because
# the rootless host publishes a non-standard port (typically 8443).
http://@@USER@@.@@T3_DOMAIN@@ {
	redir https://@@USER@@.@@T3_DOMAIN@@@@CADDY_HTTPS_PORT_SUFFIX@@{uri} 308
}

https://@@USER@@.@@T3_DOMAIN@@ {
	tls internal

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>uri query {
				delete token
				delete access_token
				delete id_token
				delete code
				delete session
				delete api_key
			}
		}
	}

	# Optional SSO. See the commented optional_sso snippet in Caddyfile.tmpl.
	# import optional_sso

	reverse_proxy @@UPSTREAM@@ {
		# T3 Code v0.0.45 rebuilds request URLs from Host and X-Forwarded-Proto.
		# Preserve the incoming Host; leave Caddy's standard X-Forwarded-* behavior on.
		header_up Host {http.request.host}
		# T3 Code does not mark its session cookie Secure; add it at the TLS edge.
		header_down Set-Cookie "^(.*)$" "$1; Secure"
		# Caddy handles WebSocket upgrades automatically. Leave stream_timeout unset;
		# allow long-running connections, and give them time to drain on reload.
		stream_close_delay 5m
	}
}
