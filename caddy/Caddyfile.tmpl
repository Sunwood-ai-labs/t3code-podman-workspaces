# Generated by scripts/render-caddy.sh. Edit the template, not this file.
{
	# The admin API is not needed for this static deployment.
	admin off
	# Per-user HTTP sites below redirect to the public, possibly non-standard TLS port.
	auto_https disable_redirects
	# Only TCP is published, so do not advertise HTTP/3.
	servers {
		protocols h1 h2
	}
}

# Reject HTTP requests for hosts that are not listed in users.conf.
:80 {
	respond "Unknown host" 421
}

